<Window x:Class="PalPeek.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalPeek 设置" Width="680" Height="620" MinWidth="560" MinHeight="480"
        Icon="pack://application:,,,/PalPeek;component/Assets/palpeek.ico"
        Background="{StaticResource BackgroundBrush}" Foreground="#F4F6FA"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="设置" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="控制 PalPeek 何时共享游戏，以及是否随 Windows 启动。"
                       Foreground="#9DA8BA" Margin="0,4,0,18"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="隐身" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="开启后，无论游玩什么游戏，都不会显示在好友的 PalPeek 中。"
                                       Foreground="#9DA8BA" TextWrapping="Wrap" Margin="0,5,20,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="开启隐身" IsChecked="{Binding Invisible}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="观战画质" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="本机启动 Moonlight 观看好友时使用。修改不会中断当前播放，将在下次连接时生效。"
                                       Foreground="#9DA8BA" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding SelectedQualityOption, Mode=TwoWay}"
                                  VerticalAlignment="Center" Padding="8,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                   Foreground="#596376"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Expander IsExpanded="True" Foreground="#F4F6FA">
                        <Expander.Header>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="始终禁止共享的游戏"
                                           FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="点击此处收起或展开游戏列表"
                                           Foreground="#9DA8BA" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="24,12,0,0">
                            <TextBlock Text="按 Steam 游戏设置。规则使用 App ID 保存，游戏更新或移动位置后仍然有效。"
                                       Foreground="#9DA8BA" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="没有找到已安装的 Steam 游戏。"
                                       Foreground="#788396" Visibility="{Binding EmptyGamesVisibility}"/>
                            <ItemsControl ItemsSource="{Binding Games}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="{Binding AppIdText}"
                                                           FontSize="11" Foreground="#788396"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Content="禁止共享"
                                                      IsChecked="{Binding IsBlocked}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开机自启" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="登录 Windows 后在后台启动 PalPeek。安装时默认开启。"
                                       Foreground="#9DA8BA" TextWrapping="Wrap" Margin="0,5,20,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="开机启动"
                                  IsChecked="{Binding StartWithWindows}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="常见问题" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="查看连接和使用问题的说明。"
                                       Foreground="#9DA8BA" Margin="0,5,20,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="查看文档" Click="FaqButton_Click"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="卸载 PalPeek" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="移除程序文件、快捷方式和 PalPeek 防火墙规则。"
                                       Foreground="#9DA8BA" TextWrapping="Wrap" Margin="0,5,20,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="卸载 PalPeek…"
                                Click="UninstallButton_Click" VerticalAlignment="Center"
                                Background="#D75A65" Foreground="White"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{Binding SaveStatus}" Foreground="#79E2B8"
                       VerticalAlignment="Center"/>
            <Button Content="完成" Click="DoneButton_Click"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
