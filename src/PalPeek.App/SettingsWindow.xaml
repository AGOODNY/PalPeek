<UserControl x:Class="PalPeek.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Storyboard x:Key="SaveStatusStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SaveStatusNotice"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.16" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:3.46" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="共享设置" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="控制隐私、观战画质和 PalPeek 的启动行为"
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <Border x:Name="SaveStatusNotice"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#10251F" BorderBrush="#245A49"
                    BorderThickness="1" CornerRadius="7" Padding="12,8"
                    Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SaveStatus, FallbackValue=设置会自动保存}"
                               Foreground="{StaticResource SuccessBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Height="2" Background="{StaticResource BorderBrush}" Margin="0,0,0,20">
            <Border Width="92" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,24">
                <TextBlock Text="PRIVACY / 隐私" Style="{StaticResource SectionLabelStyle}"
                           Margin="0,0,0,10"/>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="隐身模式" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="开启后，无论游玩什么游戏，都不会显示在好友的 PalPeek 中。"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" Margin="0,5,24,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="开启隐身"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding Invisible}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock Text="STREAM QUALITY / 观战画质"
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="0,10,0,10"/>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="选择本机观看好友时使用的串流档位"
                                   FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="修改不会中断当前播放，将在下次连接时生效。"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="0,5,0,16"/>
                        <UniformGrid Columns="3">
                            <RadioButton GroupName="Quality" IsChecked="{Binding IsQuality72030}"
                                         Style="{StaticResource QualityRadioButtonStyle}"
                                         Margin="0,0,8,0">
                                <Border Style="{StaticResource CardStyle}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="省流" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="720P · 30FPS" FontFamily="Bahnschrift"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,7,0,2"/>
                                        <TextBlock Text="2 Mbps · 网络受限时更稳定"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>
                            <RadioButton GroupName="Quality" IsChecked="{Binding IsQuality72060}"
                                         Style="{StaticResource QualityRadioButtonStyle}"
                                         Margin="4,0">
                                <Border Style="{StaticResource CardStyle}" Padding="14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="流畅" FontSize="16" FontWeight="SemiBold"/>
                                            <Border Background="#173C3A" CornerRadius="8"
                                                    Margin="8,0,0,0" Padding="7,2">
                                                <TextBlock Text="推荐" Foreground="{StaticResource AccentBrush}"
                                                           FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="720P · 60FPS" FontFamily="Bahnschrift"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,7,0,2"/>
                                        <TextBlock Text="4 Mbps · 默认平衡档位"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>
                            <RadioButton GroupName="Quality" IsChecked="{Binding IsQuality108060}"
                                         Style="{StaticResource QualityRadioButtonStyle}"
                                         Margin="8,0,0,0">
                                <Border Style="{StaticResource CardStyle}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="清晰" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="1080P · 60FPS" FontFamily="Bahnschrift"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,7,0,2"/>
                                        <TextBlock Text="8 Mbps · 需要更好的网络"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <TextBlock Text="GAME POLICY / 游戏规则"
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="0,10,0,10"/>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Expander IsExpanded="True" Foreground="{StaticResource PrimaryTextBrush}">
                        <Expander.Header>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="始终禁止共享的游戏"
                                           FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="规则按 Steam App ID 保存，点击标题可收起列表"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="24,14,0,0">
                            <TextBlock Text="没有找到已安装的 Steam 游戏。"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding EmptyGamesVisibility}"/>
                            <ItemsControl ItemsSource="{Binding Games}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource RaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="72" Height="42" CornerRadius="6"
                                                        Background="#172435" ClipToBounds="True">
                                                    <Image Source="{Binding Artwork}"
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,16,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding AppIdText}"
                                                               FontFamily="Bahnschrift"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Content="禁止共享"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding IsBlocked}"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </Border>

                <TextBlock Text="WEB WATCH / 网页观战" Style="{StaticResource SectionLabelStyle}"
                           Margin="0,10,0,10"/>
                <Border Style="{StaticResource SettingsCardStyle}" BorderBrush="#245A50">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="浏览器链接观战" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="创建固定链接和口令，让任意系统的现代浏览器通过 Tailscale Funnel 观看。"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" Margin="0,5,24,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="管理网页观战…"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BrowserWatchButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock Text="SYSTEM / 系统" Style="{StaticResource SectionLabelStyle}"
                           Margin="0,10,0,10"/>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开机自启" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="登录 Windows 后在后台启动 PalPeek。"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,5,24,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="开机启动"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="{Binding StartWithWindows}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="帮助中心" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="查看连接、分享和观战问题的处理说明。"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,5,24,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开帮助"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="FaqButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}"
                        BorderBrush="#6A3340" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="卸载 PalPeek" FontSize="17" FontWeight="SemiBold"
                                       Foreground="#FF8290"/>
                            <TextBlock Text="移除程序文件、快捷方式和 PalPeek 防火墙规则。"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" Margin="0,5,24,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="卸载 PalPeek…"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="UninstallButton_Click"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
