<UserControl x:Class="PalPeek.DiagnosticsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="连接诊断" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="逐项检查分享和观战链路，不会主动启动串流"
                           Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <Button x:Name="RefreshButton" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Content="重新扫描"
                    Click="RefreshButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Height="2" Background="{StaticResource BorderBrush}" Margin="0,0,0,20">
            <Border Width="92" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="DIAGNOSTIC PIPELINE / 链路状态"
                               Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Text="{Binding SummaryText}" HorizontalAlignment="Right"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontFamily="Bahnschrift, Microsoft YaHei UI"
                               FontSize="11"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#173C3A" BorderBrush="#247069"
                            BorderThickness="1" CornerRadius="8" Padding="12,7">
                        <TextBlock Text="TAILSCALE" Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Bahnschrift" FontSize="11"/>
                    </Border>
                    <Border Grid.Column="1" Height="1" Background="{StaticResource BorderBrush}"
                            VerticalAlignment="Center" Margin="8,0"/>
                    <Border Grid.Column="2" Background="{StaticResource RaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,7">
                        <TextBlock Text="好友发现" FontSize="11"/>
                    </Border>
                    <Border Grid.Column="3" Height="1" Background="{StaticResource BorderBrush}"
                            VerticalAlignment="Center" Margin="8,0"/>
                    <Border Grid.Column="4" Background="{StaticResource RaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,7">
                        <TextBlock Text="PALPEEK API" FontFamily="Bahnschrift" FontSize="11"/>
                    </Border>
                    <Border Grid.Column="5" Height="1" Background="{StaticResource BorderBrush}"
                            VerticalAlignment="Center" Margin="8,0"/>
                    <Border Grid.Column="6" Background="{StaticResource RaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,7">
                        <TextBlock Text="观看名额" FontSize="11"/>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="2" Margin="0,15,0,0"
                           Text="SUNSHINE  →  游戏窗口  →  游戏音频  →  编码器  →  MOONLIGHT 配对  →  播放器"
                           FontFamily="Bahnschrift, Microsoft YaHei UI"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,8,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}"
                                Padding="15" Margin="0,0,0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{Binding StatusColor}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusIcon}" Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Bahnschrift, Microsoft YaHei UI"
                                               FontSize="16"
                                               FontWeight="Bold"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Margin="10,3,10,0"
                                           TextWrapping="Wrap"/>
                                <StackPanel Grid.Column="2" Margin="10,0,18,0">
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ActionText}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" Margin="0,5,0,0"
                                               FontSize="12"/>
                                </StackPanel>
                                <Border Grid.Column="3" Background="{Binding StatusColor}"
                                        CornerRadius="10" Padding="10,4"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White"
                                               FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
