<Window x:Class="PalPeek.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalPeek 连接诊断" Width="760" Height="720"
        MinWidth="620" MinHeight="520"
        Icon="pack://application:,,,/PalPeek;component/Assets/palpeek.ico"
        Background="{StaticResource BackgroundBrush}" Foreground="#F4F6FA"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="False">
            <StackPanel>
                <TextBlock Text="连接诊断" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="逐项检查分享和观战链路，不会主动启动串流。"
                           Foreground="#9DA8BA" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="RefreshButton" DockPanel.Dock="Right"
                    Content="刷新检查" Click="RefreshButton_Click"
                    VerticalAlignment="Center" Width="100"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#252B39" CornerRadius="8"
                Padding="12" Margin="0,18,0,14">
            <TextBlock Text="Tailscale → 好友发现 → PalPeek API → 观看名额&#x0a;Sunshine → 游戏窗口 → 游戏音频 → 编码器 → Moonlight 配对 → 播放器"
                       Foreground="#B8C2D4" TextWrapping="Wrap"
                       TextAlignment="Center" LineHeight="23"/>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}"
                                CornerRadius="10" Padding="15" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="16"
                                           FontWeight="SemiBold" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ActionText}" Foreground="#9DA8BA"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{Binding StatusColor}"
                                        CornerRadius="10" Padding="10,4"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White"
                                               FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding SummaryText}" Foreground="#9DA8BA"
                       VerticalAlignment="Center"/>
            <Button Content="完成" Click="DoneButton_Click"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Background="#343B4A" Foreground="#F4F6FA"/>
        </DockPanel>
    </Grid>
</Window>
