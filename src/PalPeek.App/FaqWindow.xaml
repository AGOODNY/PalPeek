<UserControl x:Class="PalPeek.FaqWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="帮助中心" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="快速处理连接、分享和观战问题"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>
        <Border Grid.Row="1" Height="2" Background="{StaticResource BorderBrush}"
                Margin="0,0,0,20">
            <Border Width="92" Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Left"/>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="QUICK LINKS" Style="{StaticResource SectionLabelStyle}"
                               Margin="0,0,0,16"/>
                    <Button Content="看不到好友" Tag="看不到好友"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Click="QuickLink_Click"/>
                    <Button Content="无法开始观战" Tag="无法开始观战"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Click="QuickLink_Click"/>
                    <Button Content="分享状态异常" Tag="分享状态异常"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,8"
                            Click="QuickLink_Click"/>
                    <Border Margin="0,18,0,0" Background="#10251F"
                            BorderBrush="#245A49" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="安全提示" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="PalPeek 只传输游戏画面和音频，不提供远程控制。"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="22">
                <FlowDocumentScrollViewer x:Name="DocumentView"
                                          VerticalScrollBarVisibility="Auto"
                                          IsToolBarVisible="False"
                                          Background="Transparent"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
