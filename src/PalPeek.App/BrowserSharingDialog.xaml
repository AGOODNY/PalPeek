<Window x:Class="PalPeek.BrowserSharingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网页观战" Width="780" Height="760" MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="网页观战" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="管理公网入口、固定链接和浏览器串流画质"
                       Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Margin="0,22,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="允许公网浏览器观战" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="启用后，当前允许分享的游戏会自动开放给通过口令验证的观众。"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,20,0"/>
                    </StackPanel>
                    <CheckBox x:Name="EnabledCheckBox" Grid.Column="1" Content="已开启"
                              Style="{StaticResource ToggleSwitchStyle}" Click="EnabledCheckBox_Click"
                              VerticalAlignment="Center"/>
                </Grid>
                <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tailscale Funnel 公网入口" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FunnelStatusText" Text="正在检查…"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,20,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="ConfigureFunnelButton" Content="配置入口"
                                Click="ConfigureFunnelButton_Click" Margin="0,0,8,0"/>
                        <Button x:Name="DisableFunnelButton" Content="关闭公网入口"
                                Style="{StaticResource DangerButtonStyle}" Click="DisableFunnelButton_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="浏览器画质" FontWeight="SemiBold"/>
                        <TextBlock Text="720p30 约 2 Mbps；720p60 约 4 Mbps。每名观众都会占用一份上行。"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,20,0"/>
                        <TextBlock x:Name="UploadEstimateText" Text="当前没有观众，预计网页上行为 0 Mbps。"
                                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,5,20,0"/>
                    </StackPanel>
                    <ComboBox x:Name="QualityComboBox" Grid.Column="1" SelectionChanged="QualityComboBox_SelectionChanged"
                              VerticalAlignment="Center" Padding="10,7">
                        <ComboBoxItem Content="720P · 30FPS（推荐）" Tag="P720_30"/>
                        <ComboBoxItem Content="720P · 60FPS" Tag="P720_60"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="新链接名称" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBox x:Name="InviteNameTextBox" MaxLength="40" Padding="9" Margin="0,6,0,0"
                                 Text="朋友观战"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="固定口令（8–128 字符）" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <PasswordBox x:Name="InvitePasswordBox" MaxLength="128" Padding="9" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="创建链接" Click="CreateInviteButton_Click"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="FIXED WATCH LINKS / 固定观战链接"
                               Style="{StaticResource SectionLabelStyle}" Margin="0,6,0,10"/>
                    <TextBlock x:Name="EmptyInvitesText" Text="尚未创建网页观战链接。"
                               Foreground="{StaticResource MutedTextBrush}" Margin="2,8"/>
                    <ItemsControl ItemsSource="{Binding Invites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingsCardStyle}" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock Text="{Binding StateText}" Margin="9,2,0,0"
                                                           Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding UrlText}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,6,12,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="复制" Tag="{Binding Id}" Click="CopyInviteButton_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                            <Button Content="改口令" Tag="{Binding Id}" Click="PasswordInviteButton_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                            <Button Content="{Binding ToggleText}" Tag="{Binding Id}" Click="ToggleInviteButton_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                            <Button Content="删除" Tag="{Binding Id}" Click="DeleteInviteButton_Click"
                                                    Style="{StaticResource DangerButtonStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>
            <Button Content="关闭" HorizontalAlignment="Right" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
