<Window x:Class="PalPeek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PalPeek" Width="760" Height="560" MinWidth="620" MinHeight="420"
        Background="{StaticResource BackgroundBrush}" Foreground="#F4F6FA"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel>
                <TextBlock Text="PalPeek" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="看看朋友正在玩什么" Foreground="#9DA8BA" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="{Binding LocalStatus}" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding NetworkStatus}" Foreground="#9DA8BA" HorizontalAlignment="Right"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#252B39" CornerRadius="8" Padding="12"
                Margin="0,22,0,16" Visibility="{Binding BannerVisibility}">
            <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap"/>
        </Border>
        <Grid Grid.Row="2">
            <TextBlock Text="还没有好友开放观战。&#x0a;请确认大家已连接同一个 Tailscale 网络。"
                       TextAlignment="Center" Foreground="#788396" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding EmptyVisibility}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Friends}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                    Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nickname}" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding GameName}" FontSize="15" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="#9DA8BA" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="偷看一眼" VerticalAlignment="Center"
                                            IsEnabled="{Binding CanWatch}"
                                            Click="WatchButton_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
