<Window x:Class="PalPeek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PalPeek" Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        Icon="pack://application:,,,/PalPeek;component/Assets/palpeek.ico"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Background="{StaticResource SidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Grid Width="30" Height="25">
                        <Path Data="M1,12 L12,1 L24,1 L35,12 L24,23 L12,23 Z"
                              Stretch="Uniform" Stroke="{StaticResource AccentBrush}"
                              StrokeThickness="1.8"/>
                        <Path Data="M12,7 L21,12 L12,17 Z"
                              Fill="{StaticResource AccentBrush}"/>
                    </Grid>
                    <TextBlock Text="PALPEEK" FontFamily="Bahnschrift"
                               FontWeight="Bold" FontSize="17"
                               Margin="11,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SPECTATOR NETWORK" FontFamily="Bahnschrift"
                               FontSize="9" Foreground="{StaticResource MutedTextBrush}"
                               Margin="16,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}"
                             Margin="0,0,8,0"/>
                    <TextBlock Text="TAILNET ONLINE" FontFamily="Bahnschrift"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="最小化" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="最大化" Click="MaximizeButton_Click"/>
                    <Button Content="&#xE8BB;" Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="关闭到托盘" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="NAVIGATION / 导航"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="24,26,0,14"/>
                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="HallNav" GroupName="Navigation"
                                         Style="{StaticResource NavRadioStyle}"
                                         Checked="HallNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons"
                                               FontSize="17" Width="28"/>
                                    <TextBlock Text="观战大厅" FontSize="15"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="BrowserSharingNav" GroupName="Navigation"
                                         Style="{StaticResource NavRadioStyle}"
                                         Checked="BrowserSharingNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons"
                                               FontSize="17" Width="28"/>
                                    <TextBlock Text="网页观战" FontSize="15"/>
                                    <TextBlock Text="（开发中）" FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="5,4,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SettingsNav" GroupName="Navigation"
                                         Style="{StaticResource NavRadioStyle}"
                                         Checked="SettingsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons"
                                               FontSize="17" Width="28"/>
                                    <TextBlock Text="共享设置" FontSize="15"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DiagnosticsNav" GroupName="Navigation"
                                         Style="{StaticResource NavRadioStyle}"
                                         Checked="DiagnosticsNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons"
                                               FontSize="17" Width="28"/>
                                    <TextBlock Text="连接诊断" FontSize="15"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="HelpNav" GroupName="Navigation"
                                         Style="{StaticResource NavRadioStyle}"
                                         Checked="HelpNav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons"
                                               FontSize="17" Width="28"/>
                                    <TextBlock Text="帮助" FontSize="15"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                                Margin="16" Padding="14">
                            <StackPanel>
                                <TextBlock Text="NETWORK STATUS"
                                           FontFamily="Bahnschrift"
                                           FontSize="9"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{StaticResource SuccessBrush}"
                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="Tailscale"
                                               FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBlock Text="{Binding NetworkStatus}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10" TextWrapping="Wrap"
                                           Margin="0,7,0,0"/>
                                <TextBlock Text="PALPEEK v1.0.1"
                                           FontFamily="Bahnschrift"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="9" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Page hosts -->
                <Grid Grid.Column="1" Margin="28,24,28,24">
                    <Grid x:Name="HallPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="观战大厅" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="发现 Tailnet 中正在直播的游戏"
                                           Style="{StaticResource PageSubtitleStyle}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource CardStyle}" Padding="13,9">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource SuccessBrush}"
                                             Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="LOCAL STATUS"
                                                   FontFamily="Bahnschrift" FontSize="8"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding LocalStatus}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding LocalStatus}"
                                                   MaxWidth="270"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,18,0,14">
                            <Border Height="2" Background="{StaticResource BorderBrush}"/>
                            <Border Width="92" Height="2"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#152132"
                                    BorderBrush="#2B3C53" BorderThickness="1"
                                    CornerRadius="8" Padding="12"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding BannerVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons"
                                               Foreground="{StaticResource AccentBrush}"
                                               Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Local sharing panel -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="LOCAL SHARING / 共享状态"
                                               Style="{StaticResource SectionLabelStyle}"
                                               Margin="0,0,0,10"/>
                                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="155"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border CornerRadius="10,10,0,0"
                                                    Background="#161128"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding LocalArtwork}"
                                                           Stretch="UniformToFill" Opacity="0.82"/>
                                                    <Rectangle>
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0"
                                                                                 EndPoint="0,1">
                                                                <GradientStop Offset="0"
                                                                              Color="#10000000"/>
                                                                <GradientStop Offset="1"
                                                                              Color="#D90B1019"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <StackPanel VerticalAlignment="Bottom"
                                                                Margin="18">
                                                        <TextBlock Text="ACTIVE GAME"
                                                                   FontFamily="Bahnschrift"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding LocalGameName}"
                                                                   FontSize="20" FontWeight="Bold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="18">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7"
                                                             Fill="{StaticResource SuccessBrush}"
                                                             Margin="0,0,9,0"/>
                                                    <TextBlock Text="{Binding LocalShareState}"
                                                               Foreground="{StaticResource SuccessBrush}"
                                                               FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Text="VIEWERS" FontFamily="Bahnschrift"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="9" Margin="0,18,0,2"/>
                                                <TextBlock Text="{Binding LocalViewerText}"
                                                           FontFamily="Bahnschrift"
                                                           FontSize="25" FontWeight="Bold"/>
                                                <ProgressBar Value="{Binding LocalViewerPercent, Mode=OneWay}"
                                                             Maximum="100" Height="4"
                                                             Margin="0,12,0,16"/>
                                                <Border Background="{StaticResource RaisedBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="7"
                                                        Padding="10,8" Margin="0,0,0,14">
                                                    <TextBlock Text="{Binding LocalQualityText}"
                                                               FontFamily="Bahnschrift"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               HorizontalAlignment="Center"
                                                               FontSize="10"/>
                                                </Border>
                                                <Button Content="{Binding ShareButtonText}"
                                                        IsEnabled="{Binding CanToggleShare}"
                                                        Click="ShareButton_Click"
                                                        Style="{StaticResource DangerButtonStyle}"/>
                                                <ProgressBar IsIndeterminate="True"
                                                             Margin="0,9,0,0"
                                                             Visibility="{Binding IsShareLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Friend streams -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="FRIEND STREAMS / 好友直播"
                                                   Style="{StaticResource SectionLabelStyle}"/>
                                        <ProgressBar Width="120" Height="3"
                                                     HorizontalAlignment="Right"
                                                     IsIndeterminate="True"
                                                     Visibility="{Binding IsNetworkLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <TextBlock Text="还没有好友开放观战。&#x0a;请确认大家已连接同一个 Tailscale 网络。"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding EmptyVisibility}"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Friends}"
                                                          Margin="0,0,8,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource CardStyle}"
                                                                Padding="0" Margin="0,0,0,10"
                                                                MinHeight="160">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="190"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border CornerRadius="10,0,0,10"
                                                                        Background="#172435"
                                                                        ClipToBounds="True">
                                                                    <Image Source="{Binding Artwork}"
                                                                           Stretch="UniformToFill"/>
                                                                </Border>
                                                                <Grid Grid.Column="1" Margin="18,15">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Ellipse Width="6" Height="6"
                                                                                 Fill="{StaticResource SuccessBrush}"
                                                                                 Margin="0,0,7,0"/>
                                                                        <TextBlock Text="{Binding Nickname}"
                                                                                   FontFamily="Bahnschrift, Microsoft YaHei UI"
                                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                                   FontSize="10"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Row="1" Text="{Binding GameName}"
                                                                               FontSize="19" FontWeight="Bold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding GameName}"
                                                                               Margin="0,7,0,8"/>
                                                                    <WrapPanel Grid.Row="2">
                                                                        <Border Background="{StaticResource RaisedBrush}"
                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                BorderThickness="1" CornerRadius="6"
                                                                                Padding="8,4" Margin="0,0,7,0">
                                                                            <TextBlock Text="{Binding QualityText}"
                                                                                       FontFamily="Bahnschrift"
                                                                                       FontSize="9"
                                                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                                                        </Border>
                                                                        <Border Background="{StaticResource RaisedBrush}"
                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                BorderThickness="1" CornerRadius="6"
                                                                                Padding="8,4">
                                                                            <TextBlock Text="{Binding ViewerText}"
                                                                                       FontSize="9"
                                                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                                                        </Border>
                                                                    </WrapPanel>
                                                                    <TextBlock Grid.Row="3" Text="{Binding HostText}"
                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                               FontSize="10"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Button Grid.Row="4"
                                                                            Content="{Binding WatchButtonText}"
                                                                            IsEnabled="{Binding CanWatch}"
                                                                            Click="WatchButton_Click"
                                                                            Tag="{Binding}"
                                                                            HorizontalAlignment="Stretch"/>
                                                                    <ProgressBar Grid.Row="4"
                                                                                 IsIndeterminate="True"
                                                                                 VerticalAlignment="Bottom"
                                                                                 Margin="0,0,0,-5"
                                                                                 Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                                    Padding="14,10" Margin="318,12,0,0">
                                <DockPanel>
                                    <TextBlock Text="观战仅传输游戏画面与音频，不提供远程控制"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <ContentControl x:Name="BrowserSharingPageHost" Visibility="Collapsed"/>
                    <ContentControl x:Name="SettingsPage" Visibility="Collapsed"/>
                    <ContentControl x:Name="DiagnosticsPage" Visibility="Collapsed"/>
                    <ContentControl x:Name="HelpPage" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
